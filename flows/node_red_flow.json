  {
    "id": "508a296f9b2a8669",
    "type": "function",
    "z": "5935bee6efcdf160",
    "name": "Latest 5 Readings",
    "func": "msg.topic = `\nSELECT\n    id,\n    timestamp,\n    machine_id,\n    temperature_c,\n    humidity_percent,\n    vibration_g,\n    rpm,\n    load_percent,\n    condition\nFROM machine_readings\nORDER BY id DESC\nLIMIT 5\n`;\n\nreturn msg;",
