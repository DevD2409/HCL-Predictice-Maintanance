  {
    "id": "e65975b2884d305e",
    "type": "function",
    "z": "5935bee6efcdf160",
    "name": "Process Machine Status",
    "func": "if (!msg.payload || msg.payload.length === 0) {\n    node.status({\n        fill: \"grey\",\n        shape: \"ring\",\n        text: \"No machine data\"\n    });\n\n    return null;\n}\n\nconst latest = msg.payload[0];\n\nmsg.machine = latest;\n\nif (latest.condition === \"Healthy\") {\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: \"Healthy\"\n    });\n\n}\nelse if (latest.condition === \"Warning\") {\n\n    node.status({\n        fill: \"yellow\",\n        shape: \"dot\",\n        text: \"Warning\"\n    });\n\n}\nelse if (latest.condition === \"Fault\") {\n\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: \"Fault\"\n    });\n\n}\n\nmsg.payload = latest;\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 850,
    "y": 40,
    "wires": [
      [
        "e87a905d55a96b0c",
        "9e9f89690922d2b1"
      ]
    ]
  },
  {
    "id": "e87a905d55a96b0c",
    "type": "function",
    "z": "5935bee6efcdf160",
    "name": "Prepare Dashboard Data",
    "func": "const d = msg.payload;\n\nreturn [\n    { payload: d.temperature_c, topic: \"Temperature\" },\n    { payload: d.vibration_g, topic: \"Vibration\" },\n    { payload: d.rpm, topic: \"RPM\" },\n    { payload: d.humidity_percent, topic: \"Humidity\" },\n    { payload: d.load_percent, topic: \"Load\" },\n    { payload: d.condition, topic: \"Condition\" }\n];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
